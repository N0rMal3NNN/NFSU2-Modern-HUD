{
  "manifest_version": 3,
  "name": "NFSU2.xyz Modern HUD",
  "version": "0.11.7",
  "description": "Five HUD styles and redesigned standalone 2026 status panel with angled LEDs, TKL shortcuts, Limp Mode.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NFSU2 Modern HUD \u2014 settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "input-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "storage-adapter.js",
        "shift-logic.js",
        "hotkeys.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
