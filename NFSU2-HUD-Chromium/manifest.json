{
  "manifest_version": 3,
  "name": "NFSU2.xyz Modern HUD",
  "version": "0.11.82",
  "description": "Modern HUD Public BETA \u2014 customizable dashboard for NFSU2.xyz.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NFSU2 Modern HUD \u2014 settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "input-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "storage-adapter.js",
        "shift-logic.js",
        "hotkeys.js",
        "frontvex-sounds.js",
        "frontvex-notifications.js",
        "frontvex-communication.js",
        "frontvex-contacts.js",
        "frontvex-updates.js",
        "frontvex-driving-stats.js",
        "frontvex-mycar.js",
        "frontvex-racing-phase2.js",
        "frontvex-racing.js",
        "windshield-geometry.js",
        "windshield-vision.js",
        "windshield-universal.js",
        "windshield-rain.js",
        "windshield-engine.js",
        "interior-rain-roof-asset.js",
        "interior-rain-audio.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://auth.frontvex.com/register*"
      ],
      "js": [
        "frontvex-auth.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://api.frontvex.com/*",
    "https://auth.frontvex.com/*",
    "https://signal.frontvex.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "frontvex-registry-bg.js"
  }
}
