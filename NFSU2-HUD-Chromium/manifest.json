{
  "manifest_version": 3,
  "name": "NFSU2.xyz Modern HUD",
  "version": "0.11.5",
  "description": "Car-inspired HUDs for GT-R, Corolla, Civic, RX-7, Audi, 350Z/G35, Evo/STi and Supra/RX-8, with helmet, cigarette and glass effects.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NFSU2 Modern HUD — settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "input-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "storage-adapter.js",
        "shift-logic.js",
        "hotkeys.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
