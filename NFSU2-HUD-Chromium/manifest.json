{
  "manifest_version": 3,
  "name": "NFSU2.xyz Modern HUD",
  "version": "0.11.59",
  "description": "Five HUD styles and redesigned standalone 2026 status panel with angled LEDs, TKL shortcuts, Limp Mode.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NFSU2 Modern HUD \u2014 settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "input-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "storage-adapter.js",
        "shift-logic.js",
        "hotkeys.js",
        "frontvex-sounds.js",
        "frontvex-notifications.js",
        "frontvex-communication.js",
        "frontvex-contacts.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://auth.frontvex.com/register*"
      ],
      "js": [
        "frontvex-auth.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://api.frontvex.com/*",
    "https://auth.frontvex.com/*",
    "https://signal.frontvex.com/*"
  ],
  "background": {
    "service_worker": "frontvex-registry-bg.js"
  }
}
