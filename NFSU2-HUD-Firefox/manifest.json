{
  "manifest_version": 3,
  "name": "NFSU2.xyz Modern HUD",
  "version": "0.9.73",
  "description": "Five HUD skins; owner-approved Honda zero-based layout, zero X/Y factory origins for all analog skins, saved-profile migration.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NFSU2 Modern HUD — settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "input-guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://nfsu2.xyz/*",
        "https://www.nfsu2.xyz/*"
      ],
      "js": [
        "storage-adapter.js",
        "shift-logic.js",
        "hotkeys.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nfsu2-modern-hud@unofficial.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
